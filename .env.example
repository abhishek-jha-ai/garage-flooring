# Show the small "Interactive concept" pill + noindex the site. Set to "false" once live.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: forward estimate requests to any webhook (Zapier, Make, GoHighLevel inbound webhook, etc.)
LEAD_WEBHOOK_URL=

# Optional: Google Analytics 4 / Meta Pixel IDs. Leave blank to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
